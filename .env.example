PORT=3000
CHANNEL_ACCESS_TOKEN=YOUR_ACCESS_TOKEN
CHANNEL_SECRET=YOUR_NEW_CHANNEL_SECRET
# The main owner is pinned in owner.js; only that account can assign mini admins.
# Use /avi admin add @person inside a group. Roles require the shared storage below.
# Replace these example filters with your own comma-separated lists.
BLOCKED_WORDS=badword1,badword2
BLOCKED_DOMAINS=scam.com,badsite.com
# On Deno Deploy: attach a Deno KV database first, then set this to deno-kv.
# Select Production and Preview. Local Node tests use temporary memory instead.
SEEN_STORAGE=
